# =============================================================
#  AI Sales SaaS - Web (Next.js) environment variables
# =============================================================
#  MUHIM: Vercel'da deploy qilganda ushbu o'zgaruvchi ALBATTA
#  Render'dagi API public URL'ga o'rnatilishi kerak.
#  O'rnatilmasa web http://localhost:8000 ga uriladi va
#  hech qanday tugma (profil, qidiruv, bildirishnoma va h.k.)
#  ishlamaydi.
#
#  O'rnatish: Vercel -> Project -> Settings -> Environment
#  Variables -> keyingi build uchun:
#
#      NEXT_PUBLIC_API_BASE = https://SIZNING-API.onrender.com/api/v1
#
# =============================================================

NEXT_PUBLIC_API_BASE=https://SIZNING-API.onrender.com/api/v1
