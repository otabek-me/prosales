FROM node:20-alpine AS builder

WORKDIR /app

COPY apps/web/package*.json ./
RUN npm install

COPY apps/web ./

# NEXT_PUBLIC_* o'zgaruvchilari build-vaqti o'zgaruvchilari bo'lgani uchun
# ular npm run build paytida JS ichiga bekiladi. Docker build paytida
# NEXT_PUBLIC_API_BASE ni ARG orqali o'tkazish kerak (runtime environment
# build'dan keyin hech narsa o'zgartirmaydi).
ARG NEXT_PUBLIC_API_BASE=http://localhost:8001/api/v1
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["npm", "start"]
